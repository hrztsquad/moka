APP_NAME="Moka POS"
NODE_ENV=production
PORT=3000
APP_PORT=3000
SESSION_TTL_MINUTES=120
AUTH_SECRET="change-this-long-random-secret-before-production"
COOKIE_SECURE=false

# PostgreSQL (Docker / VPS)
POSTGRES_PORT=5433
POSTGRES_DB=moka_pos_bar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/moka_pos_bar?schema=public"

# Custom Admin Account (seeded via prisma db seed)
ADMIN_EMAIL="admin"
ADMIN_NAME="Admin"
ADMIN_PASSWORD="admin"
